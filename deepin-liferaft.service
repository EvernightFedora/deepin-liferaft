[Unit]
Description=Deepin memory-pressure force-quit monitor
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/deepin-liferaft --hidden
Environment=QT_LOGGING_RULES=*.info=true
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
